# Copier ce fichier en .env et remplir les valeurs

SECRET_KEY=remplacez-par-une-cle-secrete-aleatoire-de-50-caracteres
DEBUG=False
ALLOWED_HOSTS=votre-app.up.railway.app,api.votredomaine.fr

# PostgreSQL — fourni automatiquement par Railway (ne pas modifier)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — URL(s) du frontend séparées par des virgules
CORS_ALLOWED_ORIGINS=https://votredomaine.fr,https://www.votredomaine.fr,https://votre-app.vercel.app

# Email Gmail (mot de passe d'application — 16 caractères sans espaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=votre@gmail.com
